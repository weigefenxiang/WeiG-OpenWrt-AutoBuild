{
  "version": 1,
  "rules": [
    {
      "id": "lede-tls-backend",
      "scope": { "sources": ["lede"] },
      "when": {
        "all": {
          "DEFAULT_libustream-openssl": "y",
          "PACKAGE_luci-ssl": "y",
          "PACKAGE_libustream-openssl": "y"
        }
      },
      "message": {
        "zh-CN": "LEDE 的 luci-ssl 会选择 mbedTLS，与默认 OpenSSL 冲突；请改用 luci-ssl-openssl。",
        "en": "LEDE luci-ssl selects mbedTLS and conflicts with the default OpenSSL; use luci-ssl-openssl instead."
      },
      "resolutions": [
        {
          "id": "openssl",
          "recommended": true,
          "label": { "zh-CN": "保留 OpenSSL（推荐）", "en": "Keep OpenSSL (recommended)" },
          "description": { "zh-CN": "匹配 LEDE 默认包；改用 luci-ssl-openssl。", "en": "Matches LEDE default packages and uses luci-ssl-openssl." },
          "set": {
            "PACKAGE_luci-ssl": "n",
            "PACKAGE_luci-ssl-openssl": "y",
            "PACKAGE_libustream-mbedtls": "n",
            "PACKAGE_libustream-openssl": "y"
          }
        },
        {
          "id": "mbedtls",
          "label": { "zh-CN": "保留 mbedTLS", "en": "Keep mbedTLS" },
          "description": { "zh-CN": "关闭 OpenSSL 的 ustream 后端，继续使用 luci-ssl。", "en": "Disable the OpenSSL ustream backend and keep luci-ssl." },
          "set": {
            "PACKAGE_luci-ssl": "y",
            "PACKAGE_luci-ssl-openssl": "n",
            "PACKAGE_libustream-mbedtls": "y",
            "PACKAGE_libustream-openssl": "n"
          }
        }
      ]
    },
    {
      "id": "lede-linux-6.12-ksmbd",
      "prompt": "always",
      "scope": {
        "sources": ["lede"],
        "branches": ["master"]
      },
      "maintenance": {
        "observedUpstream": "coolsnowwolf/lede@f9dcc54b",
        "observedKernel": "6.12.100",
        "observedPackage": "ksmbd 3.5.4",
        "evidence": "https://github.com/weigefenxiang/WeiG-OpenWrt-AutoBuild/actions/runs/30743779443",
        "reviewWhen": "Re-test and remove this rule after LEDE updates its external ksmbd package for the Linux 6.12 VFS API."
      },
      "when": {
        "all": {
          "LINUX_6_12": "y"
        },
        "any": {
          "PACKAGE_luci-app-ksmbd": ["y", "m"],
          "PACKAGE_ksmbd-server": ["y", "m"],
          "PACKAGE_kmod-fs-ksmbd": ["y", "m"]
        }
      },
      "message": {
        "zh-CN": "当前 LEDE master 的外置 ksmbd 3.5.4 与 Linux 6.12 VFS API 不兼容，会在编译 ksmbd 时失败。",
        "en": "The external ksmbd 3.5.4 currently used by LEDE master is incompatible with the Linux 6.12 VFS API and fails while compiling ksmbd."
      },
      "resolutions": [
        {
          "id": "disable-ksmbd",
          "recommended": true,
          "label": { "zh-CN": "关闭不兼容的 ksmbd（推荐）", "en": "Disable incompatible ksmbd (recommended)" },
          "description": { "zh-CN": "关闭 ksmbd 内核模块、服务端、LuCI 和关联语言包；其它 SMB 实现不受影响。", "en": "Disables the ksmbd kernel module, server, LuCI app, and translations; other SMB implementations are unchanged." },
          "set": {
            "PACKAGE_autosamba_INCLUDE_KSMBD": "n",
            "PACKAGE_kmod-fs-ksmbd": "n",
            "PACKAGE_luci-app-ksmbd": "n",
            "PACKAGE_ksmbd-server": "n",
            "PACKAGE_ksmbd-hotplug": "n",
            "PACKAGE_ksmbd-avahi-service": "n"
          },
          "setPrefixes": {
            "PACKAGE_luci-i18n-ksmbd-": "n",
            "KSMBD_": "n"
          }
        }
      ]
    }
  ]
}
