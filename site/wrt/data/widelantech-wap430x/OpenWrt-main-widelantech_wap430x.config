# Minimal bootable seed config / 最精简可开机种子配置
# seed-device=widelantech-wap430x source=OpenWrt version=main (main) profile=widelantech_wap430x
# upstream-profile=widelantech_wap430x
# 其余符号由 make defconfig 自动展开 / everything else is expanded by make defconfig
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_widelantech_wap430x=y
CONFIG_TARGET_BOARD="mediatek"
CONFIG_TARGET_SUBTARGET="filogic"
CONFIG_TARGET_PROFILE="DEVICE_widelantech_wap430x"
CONFIG_TARGET_ARCH_PACKAGES="aarch64_cortex-a53"
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
