{
  "schema": 1,
  "name": "WeiG-OpenWrt-AutoBuild",
  "repository": "weigefenxiang/WeiG-OpenWrt-AutoBuild",
  "catalogRepository": "weigefenxiang/WeiG-OpenWrt-Menuconfig-Catalog",
  "blogUrl": "https://www.weigeshare.cc.cd/",
  "catalogReleaseTag": "menuconfig-catalog-complete",
  "catalogSelectionPolicy": {
    "sourcePriority": [
      "ImmortalWrt",
      "lede",
      "OpenWrt",
      "hanwckf"
    ],
    "defaultSource": "ImmortalWrt",
    "developmentBranches": [
      "master",
      "main"
    ],
    "preferredTarget": {
      "selectors": {
        "system": "x86",
        "subtarget": "64",
        "profile": "DEVICE_generic"
      }
    }
  },
  "catalogLoadPolicy": {
    "startup": [
      "menu",
      "menu:language",
      "package-mirrors"
    ],
    "idle": [
      "applications",
      "hidden",
      "help",
      "compatibility"
    ],
    "startupConcurrency": 3,
    "idleConcurrency": 1,
    "idleDelayMs": 15000
  },
  "catalogDataBranches": {
    "fixDefault": "catalog-dev",
    "fixOverrides": {},
    "legacyFix": "catalog-fix",
    "dev": "catalog-dev",
    "staging": "catalog-staging",
    "main": "catalog-main"
  }
}
